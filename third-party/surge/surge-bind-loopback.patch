+func TestSurguiManaged_TokenNotPersisted(t *testing.T) {
+	// Isolate every XDG location so the assertion cannot see (or pollute)
+	// real or suite-shared state.
+	stateDir := t.TempDir()
+	t.Setenv("XDG_STATE_HOME", stateDir)
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_DATA_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	t.Setenv("XDG_RUNTIME_DIR", t.TempDir())
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("APPDATA", t.TempDir())
+
+	certPEM, keyPEM := makeSurguiTestCertPEM(t)
+	port := surguiTestFreePort(t)
+	const token = "surgui-ephemeral-token-0123456789abcdef"
+	setSurguiTestEnv(t, port, certPEM, keyPEM, token)
+
+	cfg, err := surguiManagedConfigFromEnv()
+	if err != nil {
+		t.Fatalf("expected valid config, got: %v", err)
+	}
+	if _, err := loadSurguiManagedCert(cfg.certPEM, cfg.keyPEM); err != nil {
+		t.Fatalf("expected valid PEM pair, got: %v", err)
+	}
+	startSurguiTestTLSServer(t, cfg.port, cfg.certPEM, cfg.keyPEM, cfg.authToken)
+
+	// The ephemeral token must never land in the persisted token file, and
+	// no token file may be created as a side effect.
+	if data, err := os.ReadFile(resolveTokenPath()); err == nil {
+		if strings.Contains(string(data), token) {
+			t.Fatalf("ephemeral managed token was persisted to %s", resolveTokenPath())
+		}
+		t.Fatalf("managed server created token file %s (must not persist auth state)", resolveTokenPath())
+	} else if !os.IsNotExist(err) {
+		t.Fatalf("unexpected error reading token file: %v", err)
+	}
+}
