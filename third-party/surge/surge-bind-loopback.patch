+// Tests for the Surgui-managed server (see root_http_server.go managed section).
+//
+// Every test uses isolated temp dirs / env and never touches the real user
+// state. TLS tests generate throwaway self-signed certs in memory; no TLS
+// key/cert files are written.
+
+func makeSurguiTestCertPEM(t *testing.T) (certPEM, keyPEM string) {
+	t.Helper()
+
+	priv, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatalf("failed to generate test key: %v", err)
+	}
+	template := x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "surgui-managed-test"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		KeyUsage:              x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment,
+		ExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IPAddresses:           []net.IP{net.ParseIP("127.0.0.1")},
+		DNSNames:              []string{"localhost"},
+		BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, &template, &template, &priv.PublicKey, priv)
+	if err != nil {
+		t.Fatalf("failed to create test certificate: %v", err)
+	}
+	keyDER, err := x509.MarshalPKCS8PrivateKey(priv)
+	if err != nil {
+		t.Fatalf("failed to marshal test key: %v", err)
+	}
+
+	certPEM = string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))
+	keyPEM = string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER}))
+	if certPEM == "" || keyPEM == "" {
+		t.Fatal("failed to encode test PEM")
+	}
+	return certPEM, keyPEM
+}
+
+// setSurguiTestEnv points the managed config at explicit in-memory values.
+func setSurguiTestEnv(t *testing.T, port int, certPEM, keyPEM, token string) {
+	t.Helper()
+	t.Setenv("SURGUI_PORT", strconv.Itoa(port))
+	t.Setenv("SURGUI_TLS_CERT_PEM", certPEM)
+	t.Setenv("SURGUI_TLS_KEY_PEM", keyPEM)
+	t.Setenv("SURGUI_AUTH_TOKEN", token)
+}
+
+// clearSurguiTestEnv blanks every managed input (fail-closed baseline).
+func clearSurguiTestEnv(t *testing.T) {
+	t.Helper()
+	t.Setenv("SURGUI_PORT", "")
+	t.Setenv("SURGUI_TLS_CERT_PEM", "")
+	t.Setenv("SURGUI_TLS_KEY_PEM", "")
+	t.Setenv("SURGUI_AUTH_TOKEN", "")
+}
+
+// surguiTestFreePort returns a currently-free loopback port. The socket is
+// closed before return, so callers must tolerate a (very unlikely) race and
+// treat bind errors as fatal.
+func surguiTestFreePort(t *testing.T) int {
+	t.Helper()
+	requireTCPListener(t)
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to find free port: %v", err)
+	}
+	defer func() { _ = ln.Close() }()
+	return ln.Addr().(*net.TCPAddr).Port
+}
+
+// surguiTestHTTPSClient trusts only the throwaway test certs.
+func surguiTestHTTPSClient() *http.Client {
+	return &http.Client{
+		Timeout: 5 * time.Second,
+		Transport: &http.Transport{
+			TLSClientConfig: &tls.Config{InsecureSkipVerify: true, MinVersion: tls.VersionTLS12}, //nolint:gosec // test-only throwaway certs
+		},
+	}
+}
+
+// startSurguiTestTLSServer serves the managed handler over TLS on an explicit
+// loopback port using the prevalidated in-memory certificate and waits until
+// /health answers over HTTPS.
+func startSurguiTestTLSServer(t *testing.T, port int, certPEM, keyPEM, token string) *http.Server {
+	t.Helper()
+
+	ln, err := bindSurguiManagedListener(port)
+	if err != nil {
+		t.Fatalf("failed to bind managed listener: %v", err)
+	}
+	cert, err := loadSurguiManagedCert(certPEM, keyPEM)
+	if err != nil {
+		_ = ln.Close()
+		t.Fatalf("failed to load test cert: %v", err)
+	}
+	svc := service.NewLocalDownloadService(nil)
+	srv := newSurguiManagedServer(token, port, svc)
+	srv.TLSConfig = &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		MinVersion:   tls.VersionTLS12,
+	}
+
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- srv.ServeTLS(ln, "", "") }()
+	t.Cleanup(func() {
+		_ = srv.Close()
+		select {
+		case <-serveErr:
+		case <-time.After(10 * time.Second):
+			t.Errorf("managed TLS test server did not stop")
+		}
+	})
+
+	client := surguiTestHTTPSClient()
+	defer client.CloseIdleConnections()
+	url := fmt.Sprintf("https://127.0.0.1:%d/health", port)
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		req, reqErr := http.NewRequest(http.MethodGet, url, nil)
+		if reqErr != nil {
+			t.Fatalf("failed to build request: %v", reqErr)
+		}
+		req.Header.Set("Authorization", "Bearer "+token)
+		resp, doErr := client.Do(req)
+		if doErr == nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+			if resp.StatusCode == http.StatusOK {
+				return srv
+			}
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("managed TLS test server on port %d never became ready", port)
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}
+
+func TestSurguiManaged_ConfigMissingFailsClosed(t *testing.T) {
+	certPEM, keyPEM := makeSurguiTestCertPEM(t)
+	port := surguiTestFreePort(t)
+	const token = "surgui-test-token-0123456789abcdef"
+
+	cases := map[string]func(){
+		"port":     func() { setSurguiTestEnv(t, port, certPEM, keyPEM, token); t.Setenv("SURGUI_PORT", "") },
+		"certPEM":  func() { setSurguiTestEnv(t, port, certPEM, keyPEM, token); t.Setenv("SURGUI_TLS_CERT_PEM", "") },
+		"keyPEM":   func() { setSurguiTestEnv(t, port, certPEM, keyPEM, token); t.Setenv("SURGUI_TLS_KEY_PEM", "") },
+		"token":    func() { setSurguiTestEnv(t, port, certPEM, keyPEM, token); t.Setenv("SURGUI_AUTH_TOKEN", "") },
+		"cert PEM": func() { setSurguiTestEnv(t, port, "   ", keyPEM, token) },
+		"key PEM":  func() { setSurguiTestEnv(t, port, certPEM, "   ", token) },
+	}
+	for name, setup := range cases {
+		t.Run("missing_"+strings.ReplaceAll(name, " ", "_"), func(t *testing.T) {
+			setup()
+			if _, err := surguiManagedConfigFromEnv(); err == nil {
+				t.Fatalf("expected error with missing %s, got nil", name)
+			}
+		})
+	}
+}
