+// Surgui-managed Surge server (TLS-only loopback, environment-configured).
+//
+// This file is part of the Surgui auditable patch set on top of Surge
+// v0.12.4. It adds an internal `surgui-managed-server` command used only by
+// the Surgui desktop app to spawn its bundled daemon. Design rules:
+//
+//   - Listens only on 127.0.0.1 with an explicit port from SURGUI_PORT.
+//     There is no port scan fallback: an occupied port fails closed.
+//   - TLS only. ServeTLS with the in-memory PEM pair from SURGUI_TLS_CERT_PEM /
+//     SURGUI_TLS_KEY_PEM via tls.X509KeyPair. There is no plaintext path in
+//     this file and no TLS key/cert files are read.
+//   - Fails closed when any of SURGUI_PORT, SURGUI_TLS_CERT_PEM,
+//     SURGUI_TLS_KEY_PEM, or SURGUI_AUTH_TOKEN is missing or invalid.
+//   - The bearer token comes only from SURGUI_AUTH_TOKEN. It is never read
+//     from --token / SURGE_TOKEN, never written to disk (no token-file
+//     persistence), and never logged (errors are sanitized).
+//   - Download state is preserved: the same local engine, settings, store,
+//     startup integrity check, headless consumer, and auto-resume path as
+//     `surge server` are used. No unrelated upstream behavior is changed.
+
+// surguiManagedHost is fixed. It is intentionally separate from
+// serverBindHost so the managed listener stays loopback-only even if the
+// general bind host ever changes.
+const surguiManagedHost = "127.0.0.1"
+
+// surguiManagedConfig carries the validated managed-mode launch inputs.
+// authToken is held in memory only and must never be logged or persisted.
+// certPEM and keyPEM are held in memory only and must never be written to disk.
+type surguiManagedConfig struct {
+	port      int
+	certPEM   string
+	keyPEM    string
+	authToken string
+}
+
+// validateSurguiManagedToken mirrors the Surgui client's managed-token rule:
+// non-empty, and no ASCII whitespace or control bytes. The value itself is
+// never included in the returned error.
+func validateSurguiManagedToken(token string) error {
+	if token == "" || strings.TrimSpace(token) == "" {
+		return fmt.Errorf("surgui managed server: SURGUI_AUTH_TOKEN is required")
+	}
+	for i := 0; i < len(token); i++ {
+		if token[i] <= 0x20 || token[i] == 0x7f {
+			return fmt.Errorf("surgui managed server: SURGUI_AUTH_TOKEN contains invalid characters")
+		}
+	}
+	return nil
+}
+
+// surguiManagedConfigFromEnv loads the managed launch inputs strictly from
+// the environment. There are no flag or default fallbacks: anything missing
+// or malformed is an error (fail closed).
+func surguiManagedConfigFromEnv() (surguiManagedConfig, error) {
+	var cfg surguiManagedConfig
+
+	portStr := strings.TrimSpace(os.Getenv("SURGUI_PORT"))
+	if portStr == "" {
+		return cfg, fmt.Errorf("surgui managed server: SURGUI_PORT is required")
+	}
+	port, err := strconv.Atoi(portStr)
+	if err != nil || port < 1 || port > 65535 {
+		return cfg, fmt.Errorf("surgui managed server: SURGUI_PORT must be an integer in 1-65535")
+	}
+	cfg.port = port
+
+	certPEM := os.Getenv("SURGUI_TLS_CERT_PEM")
+	if strings.TrimSpace(certPEM) == "" {
+		return cfg, fmt.Errorf("surgui managed server: SURGUI_TLS_CERT_PEM is required")
+	}
+	cfg.certPEM = certPEM
+
+	keyPEM := os.Getenv("SURGUI_TLS_KEY_PEM")
+	if strings.TrimSpace(keyPEM) == "" {
+		return cfg, fmt.Errorf("surgui managed server: SURGUI_TLS_KEY_PEM is required")
+	}
+	cfg.keyPEM = keyPEM
+
+	// NOTE: raw value, no TrimSpace assignment: surrounding whitespace is
+	// rejected by validation rather than silently stripped.
+	token := os.Getenv("SURGUI_AUTH_TOKEN")
+	if err := validateSurguiManagedToken(token); err != nil {
+		return cfg, err
+	}
+	cfg.authToken = token
+
+	return cfg, nil
+}
+
+// bindSurguiManagedListener binds exactly 127.0.0.1:port. An occupied or
+// otherwise unavailable port is an error; unlike the scanning helper there
+// is no scan for a nearby free port.
+func bindSurguiManagedListener(port int) (net.Listener, error) {
+	if port < 1 || port > 65535 {
+		return nil, fmt.Errorf("surgui managed server: port must be in 1-65535")
+	}
+	ln, err := net.Listen("tcp", net.JoinHostPort(surguiManagedHost, strconv.Itoa(port)))
+	if err != nil {
+		return nil, fmt.Errorf("surgui managed server: could not bind %s:%d: %w", surguiManagedHost, port, err)
+	}
+	return ln, nil
+}
+
+// loadSurguiManagedCert validates the configured PEM pair in memory so a
+// missing value, invalid PEM, or mismatched key fails closed before the
+// listener is advertised. The error carries no key material and no raw
+// TLS error details.
+func loadSurguiManagedCert(certPEM, keyPEM string) (tls.Certificate, error) {
+	if strings.TrimSpace(certPEM) == "" || strings.TrimSpace(keyPEM) == "" {
+		return tls.Certificate{}, fmt.Errorf("surgui managed server: TLS cert and key are required")
+	}
+	cert, err := tls.X509KeyPair([]byte(certPEM), []byte(keyPEM))
+	if err != nil {
+		return tls.Certificate{}, fmt.Errorf("surgui managed server: invalid TLS cert/key")
+	}
+	return cert, nil
+}
+
+// newSurguiManagedServer builds the HTTPS handler stack (same routes, auth,
+// CORS, and body limit as the standard server) without starting anything and
+// without touching any token file. The caller serves it over TLS only.
+func newSurguiManagedServer(authToken string, port int, svc service.DownloadService) *http.Server {
+	mux := http.NewServeMux()
+	registerHTTPRoutes(mux, port, "", svc)
+	handler := corsMiddleware(authMiddleware(authToken, limitAPIRequestBody(mux)))
+	return &http.Server{
+		Handler:           handler,
+		ReadHeaderTimeout: 10 * time.Second,
+		ReadTimeout:       30 * time.Second,
+		IdleTimeout:       60 * time.Second,
+	}
+}
+
+var surguiManagedServerCmd = &cobra.Command{
+	Use:    "surgui-managed-server",
+	Short:  "Start the Surgui-managed Surge server (internal, TLS-only loopback)",
+	Hidden: true,
+	Args:   cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		return runSurguiManagedServer(cmd)
+	},
+}
+
+func init() {
+	rootCmd.AddCommand(surguiManagedServerCmd)
+}
+
+// runSurguiManagedServer is the managed-daemon entrypoint. All inputs come
+// from the environment (see surguiManagedConfigFromEnv); flag and persisted
+// token inputs are deliberately ignored here so an ephemeral managed token
+// can never arrive via process arguments or be confused with the persisted
+// user token. The token and TLS PEM values are kept in memory and never
+// written to disk.
+func runSurguiManagedServer(cmd *cobra.Command) error {
+	cfg, err := surguiManagedConfigFromEnv()
+	if err != nil {
+		return err
+	}
+	cert, err := loadSurguiManagedCert(cfg.certPEM, cfg.keyPEM)
+	if err != nil {
+		return err
+	}
+
+	lock, isMaster, err := TryAcquireInstanceLock(resolveRuntimeDir())
+	if err != nil {
+		return fmt.Errorf("surgui managed server: error acquiring lock: %w", err)
+	}
+	if !isMaster {
+		return fmt.Errorf("surgui managed server: surge server is already running")
+	}
+	defer func() {
+		if err := lock.Release(); err != nil {
+			utils.Debug("Error releasing lock: %v", err)
+		}
+	}()
+
+	if err := initializeLocalEngine(); err != nil {
+		return err
+	}
+	resetGlobalEnqueueContext()
+
+	if msg := runStartupIntegrityCheck(); msg != "" {
+		utils.Debug("%s", msg)
+		fmt.Println(msg)
+	}
+
+	if err := ensureGlobalLocalServiceAndLifecycle(); err != nil {
+		return fmt.Errorf("surgui managed server: error creating lifecycle event stream: %w", err)
+	}
+
+	ln, err := bindSurguiManagedListener(cfg.port)
+	if err != nil {
+		return err
+	}
+
+	saveActivePort(cfg.port)
+	defer removeActivePort()
+
+	savePID()
+	defer removePID()
+
+	srv := newSurguiManagedServer(cfg.authToken, cfg.port, GlobalService)
+	srv.TLSConfig = &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		MinVersion:   tls.VersionTLS12,
+	}
+	globalHTTPServerMu.Lock()
+	globalHTTPServer = srv
+	globalHTTPServerMu.Unlock()
+
+	serveErrCh := make(chan error, 1)
+	go func() {
+		// TLS only: ServeTLS with empty file arguments uses the
+		// prevalidated in-memory certificate from TLSConfig.
+		// No files are reopened here. A non-graceful
+		// failure is forwarded so the daemon shuts down promptly with a
+		// sanitized error (no token or cert material). The channel is
+		// buffered so the goroutine never blocks; on graceful shutdown
+		// ServeTLS returns http.ErrServerClosed and the goroutine exits.
+		if serveErr := srv.ServeTLS(ln, "", ""); serveErr != nil && serveErr != http.ErrServerClosed {
+			utils.Debug("surgui managed server: HTTPS server error")
+			serveErrCh <- serveErr
+		}
+	}()
+
+	fmt.Printf("Surge %s running in surgui-managed mode.\n", Version)
+	fmt.Printf("Serving on %s:%d (TLS)\n", surguiManagedHost, cfg.port)
+
+	StartHeadlessConsumer(cmd.Root().Context(), GlobalService)
+	resumePausedDownloads()
+
+	sigChan := make(chan os.Signal, 1)
+	signal.Notify(sigChan, os.Interrupt, syscall.SIGTERM, syscall.SIGHUP)
+	defer signal.Stop(sigChan)
+
+	select {
+	case sig := <-sigChan:
+		fmt.Printf("\nReceived %s. Shutting down...\n", sig)
+		_ = executeGlobalShutdown(fmt.Sprintf("surgui managed server signal: %s", sig))
+	case <-cmd.Root().Context().Done():
+		fmt.Printf("\nService stop requested. Shutting down...\n")
+		_ = executeGlobalShutdown("surgui managed server: service context cancelled")
+	case reason := <-shutDownRequested:
+		fmt.Printf("\n%s Shutting down...\n", reason)
+		_ = executeGlobalShutdown(reason)
+	case <-serveErrCh:
+		_ = executeGlobalShutdown("surgui managed server: HTTPS server error")
+		return fmt.Errorf("surgui managed server: HTTPS server error")
+	}
+	return nil
+}
