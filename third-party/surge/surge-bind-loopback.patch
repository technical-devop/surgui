+func TestSurguiManaged_WrongCertFailsClosed(t *testing.T) {
+	certPEMA, _ := makeSurguiTestCertPEM(t)
+	_, keyPEMB := makeSurguiTestCertPEM(t)
+
+	// Mismatched pair must fail validation with a sanitized error.
+	if _, err := loadSurguiManagedCert(certPEMA, keyPEMB); err == nil {
+		t.Fatal("expected error for mismatched cert/key pair, got nil")
+	} else if strings.Contains(err.Error(), certPEMA) || strings.Contains(err.Error(), keyPEMB) {
+		t.Fatal("cert/key error must not contain key material")
+	}
+
+	// Garbage PEM values must fail validation with a sanitized error.
+	if _, err := loadSurguiManagedCert("not a pem", "not a pem either"); err == nil {
+		t.Fatal("expected error for garbage cert/key values, got nil")
+	} else if strings.Contains(err.Error(), "not a pem") {
+		t.Fatal("cert/key error must not echo raw input")
+	}
+
+	// Empty values must fail validation.
+	if _, err := loadSurguiManagedCert("", ""); err == nil {
+		t.Fatal("expected error for empty cert/key values, got nil")
+	}
+	if _, err := loadSurguiManagedCert("   ", "   "); err == nil {
+		t.Fatal("expected error for whitespace cert/key values, got nil")
+	}
+
+	// A server with no in-memory certificate must fail at serve time, never
+	// falling back to plaintext: ServeTLS returns promptly with an error.
+	port := surguiTestFreePort(t)
+	ln, err := bindSurguiManagedListener(port)
+	if err != nil {
+		t.Fatalf("failed to bind: %v", err)
+	}
+	defer func() { _ = ln.Close() }()
+	svc := service.NewLocalDownloadService(nil)
+	srv := newSurguiManagedServer("surgui-test-token-0123456789abcdef", port, svc)
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- srv.ServeTLS(ln, "", "") }()
+	select {
+	case err := <-serveErr:
+		if err == nil {
+			_ = srv.Close()
+			t.Fatal("ServeTLS without certificates unexpectedly succeeded")
+		}
+	case <-time.After(10 * time.Second):
+		_ = srv.Close()
+		<-serveErr
+		t.Fatal("ServeTLS without certificates neither failed nor served; expected a prompt error")
+	}
+}
