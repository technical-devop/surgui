+func TestSurguiManaged_TLSListenerServesHTTPS(t *testing.T) {
+	requireTCPListener(t)
+	certPEM, keyPEM := makeSurguiTestCertPEM(t)
+	port := surguiTestFreePort(t)
+	const token = "surgui-test-token-0123456789abcdef"
+	startSurguiTestTLSServer(t, port, certPEM, keyPEM, token)
+
+	client := surguiTestHTTPSClient()
+	defer client.CloseIdleConnections()
+
+	validReq, _ := http.NewRequest(http.MethodGet, fmt.Sprintf("https://127.0.0.1:%d/health", port), nil)
+	validReq.Header.Set("Authorization", "Bearer "+token)
+	validResp, err := client.Do(validReq)
+	if err != nil {
+		t.Fatalf("valid HTTPS request failed: %v", err)
+	}
+	_, _ = io.Copy(io.Discard, validResp.Body)
+	_ = validResp.Body.Close()
+	if validResp.StatusCode != http.StatusOK {
+		t.Fatalf("expected 200 for valid token over TLS, got %d", validResp.StatusCode)
+	}
+
+	// Wrong token must be rejected.
+	badReq, _ := http.NewRequest(http.MethodGet, fmt.Sprintf("https://127.0.0.1:%d/list", port), nil)
+	badReq.Header.Set("Authorization", "Bearer wrong-token")
+	badResp, err := client.Do(badReq)
+	if err != nil {
+		t.Fatalf("HTTPS request failed: %v", err)
+	}
+	_, _ = io.Copy(io.Discard, badResp.Body)
+	_ = badResp.Body.Close()
+	if badResp.StatusCode != http.StatusUnauthorized {
+		t.Fatalf("expected 401 for wrong token, got %d", badResp.StatusCode)
+	}
+}
