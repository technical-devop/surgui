+func TestSurguiManaged_PortCollisionFailsClosed(t *testing.T) {
+	requireTCPListener(t)
+	// An unrelated occupant holds the port; the managed bind must fail
+	// instead of scanning for a nearby free port.
+	occupant, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to occupy port: %v", err)
+	}
+	defer func() { _ = occupant.Close() }()
+	occupiedPort := occupant.Addr().(*net.TCPAddr).Port
+
+	if _, err := bindSurguiManagedListener(occupiedPort); err == nil {
+		t.Fatalf("expected bind error on occupied port %d, got nil", occupiedPort)
+	}
+}
