+func TestSurguiManaged_NoPlaintextFallback(t *testing.T) {
+	requireTCPListener(t)
+	certPEM, keyPEM := makeSurguiTestCertPEM(t)
+	port := surguiTestFreePort(t)
+	const token = "surgui-test-token-0123456789abcdef"
+	startSurguiTestTLSServer(t, port, certPEM, keyPEM, token)
+
+	// Plain HTTP against the TLS-only port must never succeed.
+	plain := &http.Client{Timeout: 5 * time.Second}
+	defer plain.CloseIdleConnections()
+	resp, err := plain.Get(fmt.Sprintf("http://127.0.0.1:%d/health", port)) //nolint:bodyclose // error path has no body; success path closed below
+	if err == nil && resp.StatusCode != http.StatusBadRequest {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		t.Fatalf("plaintext HTTP unexpectedly succeeded with status %d; TLS-only listener must not serve plaintext", resp.StatusCode)
+	}
+	if err == nil && resp.StatusCode == http.StatusBadRequest {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}
+}
